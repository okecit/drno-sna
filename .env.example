POSTGRES_PASSWORD=ganti-dengan-kata-sandi-kuat
DATABASE_URL=postgresql://drno:ganti@db:5432/drno
REDIS_URL=redis://redis:6379/0
# Penyimpanan: jsonl (lokal, default) | postgres
DRNO_STORE=jsonl
DRNO_DATA_DIR=data
DRNO_ACTOR=peneliti
# Kunci pseudonimisasi: acak >=32 karakter, simpan TERPISAH dari backup database. JANGAN diganti setelah crawling dimulai.
DRNO_PSEUDONYM_KEY=

# ---- Kredensial API resmi (kosong = konektor tidak berjalan) ----
# X API v2 (pay-per-use): developer.x.com -> Project -> App -> Bearer Token
X_BEARER_TOKEN=
# Kueri X API (sintaks X, <=512 karakter). Kosong = kueri bawaan istilah tersamar/takfiri di worker_loop.sh
DRNO_X_QUERY=
DRNO_X_MAX=200
# YouTube Data API v3: Google Cloud Console -> API key
YOUTUBE_API_KEY=
# Meta Graph API (Instagram & Facebook): token pengguna dari aplikasi Meta yang lolos App Review
META_ACCESS_TOKEN=
IG_USER_ID=
IG_HASHTAGS=moderasiberagama,kontranarasi,deradikalisasi
FB_PAGE_IDS=
# Alternatif sementara: ScrapeCreators (layanan scraping PIHAK KETIGA, bukan API resmi Meta).
# Catat sumber ini di metode & persetujuan etik. FB_SC_PAGES = URL Page publik dipisah koma.
SCRAPECREATORS_API_KEY=
FB_SC_PAGES=
DRNO_SC_MAX_CALLS=60
DRNO_SC_POSTS_PER_PAGE=15
DRNO_SC_COMMENT_PAGES=2
# Komentar ber-balasan yang dibuka per halaman komentar (garis komentator -> komentator)
DRNO_SC_REPLY_THREADS=3
# Batas kredit sekali jalan untuk ./deploy/vps/drno.sh fb-backfill [hari]
DRNO_SC_BACKFILL_CALLS=300
DRNO_LEGAL_BASIS_FACEBOOK_SC=
# X & Instagram via ScrapeCreators (pihak ketiga). Penemuan berbasis indeks Google (tidak lengkap).
DRNO_SC_PLATFORMS=facebook,x,instagram
# Akun X publik pilihan peneliti (handle dipisah koma). Hanya akun >= DRNO_PUBLIC_MIN_FOLLOWERS yang diambil;
# endpoint memberi ~100 tweet TERPOPULER (bukan kronologis), maka jendela waktunya lebar (DRNO_SC_X_DAYS).
X_SC_ACCOUNTS=
DRNO_SC_X_DAYS=1095
# Pencarian kata kunci X berbasis Google: tidak relevan untuk istilah Indonesia; isi hanya bila diperlukan.
# DRNO_SC_X_QUERIES=thogut,"kafir harbi","anshorut daulah","jamaah islamiyah","paham takfiri",deradikalisasi
DRNO_SC_X_PAGES=1
DRNO_PUBLIC_MIN_FOLLOWERS=10000
IG_SC_HASHTAGS=deradikalisasi,kontranarasi,moderasiberagama,terorisme
DRNO_SC_IG_WINDOW=last-month
DRNO_SC_IG_COMMENT_POSTS=5
DRNO_LEGAL_BASIS_X_SC=
DRNO_LEGAL_BASIS_INSTAGRAM_SC=

# ---- Dasar hukum/izin akses per platform (wajib; konektor menolak jalan bila kosong) ----
DRNO_LEGAL_BASIS_X=
DRNO_LEGAL_BASIS_YOUTUBE=
DRNO_LEGAL_BASIS_INSTAGRAM=
DRNO_LEGAL_BASIS_FACEBOOK=

# ---- Deploy: shared hosting (cPanel) via FTPS ----
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_DIR=/public_html/drno
FTP_PORT=21
FTP_TLS=1

# ---- Deploy: VPS (Docker di belakang Nginx host) — dibuat oleh deploy/vps/init.sh ----
DRNO_DOMAIN=drno.domainanda.ac.id
# Legacy untuk deployment Caddy upstream; tidak digunakan pada VPS bersama ini.
DRNO_ACME_EMAIL=
DRNO_INTERVAL_HOURS=6
DRNO_BACKUP_KEEP_DAYS=14
DRNO_YT_VIDEOS=20
DRNO_X_MAX=200
# Scrapling (portal berita & situs publik): kontak di User-Agent, jeda per domain (detik), frekuensi (jam)
DRNO_CONTACT=
DRNO_SCRAPE_DELAY=5
DRNO_SCRAPE_EVERY_HOURS=24
DRNO_WEB_MAX=500
# Query bawaan worker (opsional; tanpa tanda kutip di sekeliling nilai):
# DRNO_QUERY=(radikalisasi OR terorisme OR deradikalisasi) AND NOT lowongan
# Query YouTube dalam sintaks YouTube (| = OR, - = NOT); DRNO_QUERY tetap dipakai sebagai filter lokal:
# DRNO_YT_QUERY=radikalisasi|terorisme|ekstremisme|deradikalisasi|"kontra narasi" -lowongan
# Crawl YouTube kedua (urut relevansi) untuk penanda ideologis berejaan khas Indonesia:
# DRNO_YT_QUERY_IDEO=thogut|"kafir harbi"|"anshorut daulah"|"jamaah islamiyah"|"paham takfiri" -film -horor
# Bila DRNO_QUERY kosong, dipakai DEFAULT_QUERY di backend/drno/keywords.py (termasuk thaghut/takfir/khilafah, dst.)
# Kanal YouTube pemilik video ditampilkan dengan nama hanya bila subscriber >= ambang ini (aktor publik);
# kanal pribadi kecil dan semua penulis komentar tetap berpseudonim:
# DRNO_PUBLIC_CHANNEL_MIN_SUBS=10000
